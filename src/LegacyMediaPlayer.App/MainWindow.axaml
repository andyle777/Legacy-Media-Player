<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:LegacyMediaPlayer.App"
        xmlns:app="using:LegacyMediaPlayer.Application"
        x:Class="LegacyMediaPlayer.App.MainWindow"
        Title="Legacy Media Player" Width="1000" Height="600"
        MinWidth="900" MinHeight="500" Background="#D4D0C8">
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="10">
    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,8">
      <Button x:Name="OpenButton" Content="Open files…" ToolTip.Tip="Open files (Ctrl+O)" Click="OnOpen" />
      <Button x:Name="AddButton" Grid.Column="1" Content="Add to queue…" ToolTip.Tip="Add to queue (Ctrl+Shift+A; Ctrl+Shift+O)" Click="OnAdd" Margin="6,0,0,0" />
      <TextBlock x:Name="ModeLabel" Grid.Column="2" HorizontalAlignment="Right"
                 VerticalAlignment="Center" Foreground="#454545" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,310">
    <Border BorderBrush="#808080" BorderThickness="2" Background="Black">
      <Grid>
        <TextBlock x:Name="Placeholder" Text="Legacy Media Player" Foreground="#BBBBBB"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" />
        <local:VideoHost x:Name="VideoSurface" />
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" Margin="10,0,0,0">
      <TextBlock x:Name="QueueLabel" Text="Queue · 0 tracks" Margin="0,0,0,6" />
      <ListBox x:Name="QueueList" Grid.Row="1" SelectionChanged="OnQueueSelection"
               DoubleTapped="OnQueueDoubleTap" AutomationProperties.Name="Playback queue">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="app:QueueItem">
            <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding Source.Path}"
                       TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5" Margin="0,6,0,0">
        <Button x:Name="PlaySelectedButton" Content="Play selected" Click="OnPlaySelected" />
        <Button x:Name="RemoveButton" Content="Remove" Click="OnRemove" />
      </StackPanel>
      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="5" Margin="0,5,0,0">
        <Button x:Name="MoveUpButton" Content="Move up" Click="OnMoveUp" />
        <Button x:Name="MoveDownButton" Content="Move down" Click="OnMoveDown" />
      </StackPanel>
    </Grid>
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,4">
      <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" IsEnabled="False"
              KeyUp="OnSeekKeyUp"
              AutomationProperties.Name="Playback position" />
      <TextBlock x:Name="TimeLabel" Grid.Column="1" Width="135" TextAlignment="Right" VerticalAlignment="Center" />
    </Grid>
    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,160,Auto">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <Button x:Name="PreviousButton" Content="Previous" Click="OnPrevious" />
        <Button x:Name="PlayButton" Content="Play" Click="OnPlay" />
        <Button x:Name="PauseButton" Content="Pause" Click="OnPause" />
        <Button x:Name="StopButton" Content="Stop" Click="OnStop" />
        <Button x:Name="NextButton" Content="Next" Click="OnNext" />
      </StackPanel>
      <TextBlock Grid.Column="2" Text="Volume" VerticalAlignment="Center" Margin="12,0,6,0" />
      <Slider x:Name="VolumeSlider" Grid.Column="3" Minimum="0" Maximum="100" Value="75"
              AutomationProperties.Name="Volume" />
      <Button x:Name="MuteButton" Grid.Column="4" Content="Mute" Click="OnMute" Margin="6,0,0,0" />
    </Grid>
    <StackPanel Grid.Row="4" Spacing="4" Margin="0,10,0,0">
      <TextBlock x:Name="StatusLabel" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="ErrorLabel" Foreground="#9C2020" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
